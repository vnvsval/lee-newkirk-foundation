# Copy this file to .env.local for local development, and add the same
# variables in Vercel under Project Settings → Environment Variables for
# production. Never commit a real .env.local or .env file — .gitignore
# already excludes them.

# Public base URL of the site. Used for metadata, Open Graph tags, and the
# sitemap. Set to https://theleenewkirkfoundation.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form email (optional until set) --------------------------
# Get a free API key at https://resend.com after verifying a sending
# domain. Without this, contact form submissions are logged on the server
# instead of emailed — the site still works, it just won't deliver mail.
RESEND_API_KEY=
# Inbox that should receive contact form submissions. Defaults to the
# contactEmail set in src/lib/site-config.ts if omitted.
CONTACT_FORM_TO_EMAIL=
# "From" address Resend sends as. Must be on a domain verified with Resend.
CONTACT_FORM_FROM_EMAIL=

# --- Donations (not active yet) ----------------------------------------
# Once a donation processor is chosen and donationConfig.enabled is set to
# true in src/lib/donation-config.ts, point this at the real checkout URL.
NEXT_PUBLIC_DONATION_CHECKOUT_URL=
